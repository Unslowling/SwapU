# ==============================================================================
# PLATAFORMA DE TRUEQUE ESTUDIANTIL - EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo a .env y ajusta los valores para tu entorno.
# ==============================================================================

# Entorno de ejecución: 'dev', 'test', 'prod'
# En entornos distintos a 'dev', la aplicación exige que JWT_SECRET_KEY sea segura (>= 32 caracteres y no el valor por defecto).
ENV=dev

# Conexión a Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena_segura_aqui
DATABASE_URL=postgresql+asyncpg://postgres:tu_contrasena_segura_aqui@localhost:5432/swapu
DATABASEPROVIDER=Postgres

# Si usas SQLite para pruebas locales:
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Seguridad y Autenticación JWT
# OBLIGATORIO en producción: al menos 32 caracteres aleatorios y secretos.
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_muy_larga_y_segura_de_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes Permitidos CORS (lista separada por comas o arreglo JSON). NUNCA usar '*' junto con credenciales.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:5500","http://127.0.0.1:5500"]

# Cookies Seguras (automáticamente True si ENV=prod)
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=lax

# Redis (opcional para desarrollo local; usado para mensajería y rate limiters)
REDIS_URL=redis://localhost:6379/0

# Almacenamiento local de fotos de verificación
BOOK_VERIFICATION_STORAGE_PATH=./storage/book-verification

# Servidor de Correo SMTP para confirmación de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tuuniversidad.edu.co
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM_EMAIL=notificaciones@tuuniversidad.edu.co
APP_BASE_URL=http://localhost:8000

# Google OAuth2 (Opcional para Login Social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=openid email profile

# Facebook OAuth2 (Opcional para Login Social)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
FACEBOOK_SCOPES=email,public_profile
